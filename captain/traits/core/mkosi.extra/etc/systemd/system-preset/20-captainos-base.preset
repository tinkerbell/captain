# CaptainOS preset: Base system services and cleanup
enable captainos-static-network.service
enable captainos-banner.service
enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable systemd-time-wait-sync.service
enable containerd.service
enable rsyslog.service
enable rsyslog-hostname-reload.path

disable apt-daily.timer
disable apt-daily-upgrade.timer
disable e2scrub_all.timer
disable e2scrub_reap.service
disable fstrim.timer
disable logrotate.timer
disable man-db.timer
disable remote-fs.target
disable systemd-firstboot.service

